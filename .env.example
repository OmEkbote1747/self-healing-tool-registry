# ADAPTIX configuration. Copy to .env (never commit .env) and fill in values on the SERVER only.
# Placeholders only: no real credentials belong in this file.

APP_ENV=development

# --- LLM tier (optional). Without a key, repairs the rules cannot ground stop safely. ---
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Optional second authorised key for failover (used only on rate limit / expiry)
GEMINI_API_KEY_SECONDARY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_MIN_CONFIDENCE=0.8

# --- Credential registry (optional JSON list; values are read from the named env vars, never stored here) ---
# When set, it REPLACES the default Gemini entries, so list the Gemini key too:
# ADAPTIX_CREDENTIALS=[{"alias":"gemini-primary","provider":"gemini","group":"gemini","secret_env":"GEMINI_API_KEY","scope":["llm"]},{"alias":"crm-key-a","provider":"crm","group":"crm","secret_env":"CRM_KEY_A","header":"x-api-key","scope":["tool:update_user"]}]
# CRM_KEY_A=

# --- Repair / transport limits ---
ADAPTIX_MAX_REPAIR_ATTEMPTS=2
ADAPTIX_MAX_RETRIES=2
ADAPTIX_REQUEST_TIMEOUT_SECONDS=10
ADAPTIX_TIME_BUDGET_SECONDS=30
ADAPTIX_BACKOFF_BASE_SECONDS=0.2
ADAPTIX_BACKOFF_MAX_SECONDS=4
ADAPTIX_AUTO_MIN_SIMILARITY=75

# --- API server ---
# Bearer token for /api/* (a random one is generated per process if unset)
ADAPTIX_ADMIN_TOKEN=
# Comma-separated; CORS is disabled when empty
ADAPTIX_CORS_ORIGINS=
ADAPTIX_MAX_BODY_BYTES=256000
ADAPTIX_DB_PATH=data/adaptix.db
ADAPTIX_RETENTION_DAYS=30

# --- Dashboard: point at a separately deployed API (empty = run the API in-process) ---
ADAPTIX_API_URL=
